# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Sherpa"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth / DB ───────────────────────────────────────────────────────
# Leave blank to run in Local Demo Mode (file-backed store in .data/).
# Fill these in to switch to Supabase Auth + Postgres (see SETUP.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ char secret used to sign the local session cookie
SHERPA_SESSION_SECRET=

# ── AI ──────────────────────────────────────────────────────────────
# openai | anthropic | gemini | local
# "local" (default) uses Sherpa's deterministic curriculum engine — no key needed.
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Cache ───────────────────────────────────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Payments ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Analytics / monitoring ──────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# ── Email (verification codes, reset links) ─────────────────────────
# When unset, the app runs in Local Demo Mode and echoes codes in API
# responses (devCode) so the flow is fully testable without a mailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sherpa <no-reply@sherpa.study>"

# First account created with this email gets the admin role (/admin).
SHERPA_ADMIN_EMAIL=

# Set to "true" to allow the demo Google OAuth button to mint a session
# without a real OAuth client (NOT for production).
ALLOW_DEMO_OAUTH=

# ── Jobs / link checker ─────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
